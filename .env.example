DATABASE_URL="postgresql://fullers:fullers@localhost:5432/fullers?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Explicit opt-in for the immutable, approved local catalogue. Production must use PostgreSQL.
CONTENT_SOURCE="seed"
# Used only to provision the initial administrator; no default password.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Optional high-entropy secret for a configured external scheduler calling POST /api/internal/publish-due.
PUBLISH_WORKER_SECRET=""
# Local development defaults to disk. Hosted staging should select supabase.
MEDIA_STORAGE_PROVIDER="local"
SUPABASE_URL=""
# Server-only modern sb_secret_ key; never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=""
SUPABASE_MEDIA_BUCKET="fullers-media"
